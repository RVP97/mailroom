{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "mailroom-test",
	"main": "./worker.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [{ "binding": "DB", "database_name": "mailroom-test", "database_id": "test" }],
	"durable_objects": { "bindings": [{ "name": "DISPATCHER", "class_name": "Dispatcher" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Dispatcher"] }],
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "test" }],
	"r2_buckets": [{ "binding": "INBOUND", "bucket_name": "mailroom-inbound-test" }],
	"ratelimits": [
		{
			"name": "API_KEY_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 100, "period": 10 }
		},
		{ "name": "API_IP_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 10 } }
	],
	"vars": {
		"BETTER_AUTH_URL": "https://mailroom.test",
		"AWS_REGION": "us-east-1",
		"TIMEZONE": "America/Mexico_City",
		"SYSTEM_FROM": "",
		"ADMIN_EMAILS": "admin@mailroom.test",
		"MAX_SEND_RATE": "1000",
		"BODY_RETENTION_DAYS": "7",
		"LOG_RETENTION_DAYS": "90",
		"DMARC_REPORTS_ADDRESS": "dmarc@mailroom.test",
		"INBOUND_DOMAIN": "in.mailroom.test",
		"INBOUND_RETENTION_DAYS": "30",
		"DOMAIN_CONNECT_PROVIDER_ID": "mailroom.test"
	}
}
