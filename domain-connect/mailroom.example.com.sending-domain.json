{
  "providerId": "mailroom.example.com",
  "providerName": "Mailroom",
  "serviceId": "sending-domain",
  "serviceName": "Mailroom sending domain",
  "version": 1,
  "logoUrl": "https://mailroom.example.com/favicon.svg",
  "description": "Lets Mailroom send email from this domain through Amazon SES: DKIM signing, a bounce (MAIL FROM) subdomain with SPF, an optional DMARC record, link tracking on your own domain and an optional brand logo (BIMI).",
  "variableDescription": "%dkim1%, %dkim2%, %dkim3%: the domain's Amazon SES DKIM tokens; %region%: its Amazon SES region, e.g. us-east-2",
  "syncBlock": false,
  "syncPubKeyDomain": "mailroom.example.com",
  "syncRedirectDomain": "mailroom.example.com",
  "hostRequired": false,
  "records": [
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "dkim",
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "groupId": "mailfrom",
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "mailfrom",
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1",
      "essential": "OnApply"
    },
    {
      "groupId": "tracking",
      "type": "CNAME",
      "host": "links",
      "pointsTo": "track.mailroom.example.com",
      "ttl": 3600
    },
    {
      "groupId": "bimi",
      "type": "TXT",
      "host": "default._bimi",
      "data": "v=BIMI1; l=https://mailroom.example.com/bimi/%fqdn%.svg;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=BIMI1",
      "essential": "OnApply"
    }
  ]
}
